###############################################################################
# .gitignore — Projet Linux PERFORMANCE
# -------------------------------------
# Ce fichier définit précisément ce qui NE doit PAS être versionné dans Git.
# Il protège le dépôt contre :
#   - les journaux d’exécution
#   - les fichiers temporaires
#   - les configurations locales
#   - les artefacts générés par les scripts
#   - les fichiers système inutiles
#
# Chaque section est documentée pour faciliter la maintenance du projet.
###############################################################################


# =============================================================================
# 1. JOURNAUX D’EXÉCUTION DU PROJET
# -----------------------------------------------------------------------------
# Tous les logs générés par les scripts (install, tools, setup, perf, sec,
# desktop, orchestrateur, etc.) doivent rester en local.
# Ils changent à chaque exécution et n’ont aucune valeur dans Git.
#
# Exemple :
#   logs/mint-setup-20260331-231500.log
# =============================================================================
logs/
*.log



# =============================================================================
# 2. FICHIERS TEMPORAIRES / SAUVEGARDES
# -----------------------------------------------------------------------------
# Fichiers créés automatiquement par :
#   - les éditeurs (Vim, Nano, VSCode…)
#   - les scripts shell
#   - les outils système
#
# Ils ne doivent jamais polluer l’historique Git.
# =============================================================================
*.tmp
*.temp
*.bak
*.old
*.swp
*.swo
*~



# =============================================================================
# 3. CONFIGURATIONS LOCALES NON PARTAGÉES
# -----------------------------------------------------------------------------
# Tout ce qui est spécifique à TA machine :
#   - secrets
#   - overrides locaux
#   - tests personnels
#
# Le dossier config/ global reste versionné,
# mais config/local/ est réservé aux variations privées.
# =============================================================================
config/local/
.env
.env.*



# =============================================================================
# 4. ÉDITEURS / IDE
# -----------------------------------------------------------------------------
# Métadonnées et dossiers propres aux outils de développement.
# Ils ne font pas partie du projet et ne doivent jamais être commités.
# =============================================================================

# VSCode
.vscode/

# JetBrains (IntelliJ, PyCharm, etc.)
.idea/

# Vim / Neovim
*.swp
*.swo
*.vim



# =============================================================================
# 5. ARTEFACTS GÉNÉRÉS PAR LES SCRIPTS
# -----------------------------------------------------------------------------
# Certains scripts (perf, sec, desktop, setup…) peuvent générer :
#   - fichiers temporaires
#   - caches
#   - PID
#   - sorties techniques
#
# Ces fichiers sont propres à l’exécution locale.
# =============================================================================
*.out
*.pid
*.cache
*.generated

# Dossiers internes utilisés par certains scripts
tmp/
workdir/
reports/



# =============================================================================
# 6. FICHIERS / ARTEFACTS SYSTÈME
# -----------------------------------------------------------------------------
# Fichiers créés automatiquement par l’OS ou les gestionnaires de fichiers.
# Ils n’ont rien à faire dans un dépôt Git.
# =============================================================================
.DS_Store
Thumbs.db



# =============================================================================
# 7. ARCHIVES ET EXPORTS
# -----------------------------------------------------------------------------
# Archives créées pour des backups, exports ou distributions.
# Elles ne doivent pas être versionnées.
# =============================================================================
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
